# Local dev server port (ignored on Vercel)
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Comma-separate to allow several
# (e.g. your Vercel prod URL + localhost during development).
CLIENT_ORIGIN=http://localhost:5173

# Supabase Postgres connection string.
# Supabase dashboard → Project Settings → Database → Connection string.
# Use the "Connection pooling" (Transaction mode, port 6543) URI for Vercel.
DATABASE_URL=postgresql://postgres.xzvtzucazmrdvldyxzhn:DtuwAFW4G7WpQ4w6@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
